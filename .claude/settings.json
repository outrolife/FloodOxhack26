{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/status.py\" board",
            "timeout": 30,
            "statusMessage": "Loading team status board"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/status.py\" board",
            "timeout": 30,
            "statusMessage": "Fetching team status board"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/status.py\" heartbeat",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}
